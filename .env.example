# =============================================================================
# EventSport — environment variables template
# Usage: cp .env.example .env  (Windows: copy .env.example .env)
# All values are read by docker-compose.yml from this file.
# docker-compose.yml does not expose ports to the host; services communicate
# over `eventsport_network` using container names.
# =============================================================================

# --- Docker (container names & image tags) ---
MONGO_CONTAINER_NAME=eventSport_mongodb
BACKEND_CONTAINER_NAME=eventSport_backend
FRONTEND_CONTAINER_NAME=eventSport_frontend
NGINX_CONTAINER_NAME=eventSport_nginx
# Only external port (nginx). backend/frontend do not publish host ports.
HTTP_PORT=3001
# Image tags: if missing, compose builds from Dockerfile and applies this tag.
# On low-RAM servers, pre-build frontend on the host and leave the image ready
# with this tag (see: scripts/build-frontend-prebuilt.sh).
BACKEND_IMAGE=eventsport-backend:latest
FRONTEND_IMAGE=eventsport-frontend:latest

# --- MongoDB (Docker Compose: mongodb service) ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DB=sportsevents
# Inside Docker the host name must be `mongodb` (service name).
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/sportsevents?authSource=admin

# --- Backend ---
NODE_ENV=development
# Container port (not exposed to host). Backend listens on this port.
BACKEND_PORT=3000
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
COOKIE_DOMAIN=localhost
# Browser URL (nginx single entry — CORS)
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Hero banner internal redirect (when Referer is missing, optional)
PUBLIC_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Event check-in reminder scheduler (optional)
CHECK_IN_REMINDERS_ENABLED=true
CHECK_IN_REMINDER_INTERVAL_MS=300000

# Account deletion: anonymize personal data after retention period (optional)
ACCOUNT_ANONYMIZATION_ENABLED=true
ACCOUNT_ANONYMIZATION_INTERVAL_MS=86400000
ACCOUNT_DELETION_RETENTION_MONTHS=24

# Recurring event series listing fee per slot (TRY)
LISTING_PRICE_PER_SLOT=50

# --- Registration OTP email (Brevo: smtp-relay.brevo.com, port 587) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EventSport <noreply@eventsport.local>
SMTP_SECURE=false

# --- Frontend (Next.js — rebuild frontEnd after changes) ---
# Container port (not exposed to host).
FRONTEND_PORT=3001
# Browser-facing URLs (build-time; nginx proxies /api/ and /uploads/).
# Replace with your public URL on the server (e.g. https://example.com/api/v1).
NEXT_PUBLIC_API_V1_BASE=http://localhost:3001/api/v1
NEXT_PUBLIC_API_ASSETS_BASE=http://localhost:3001
# Invite share links (uses browser origin when empty)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Admin (created automatically on first startup) ---
ADMIN_EMAIL=admin@eventsport.com
ADMIN_PASSWORD=Admin123!@#
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_PHONE=09123456789
ADMIN_AGE=1990-01-01
